<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles against the game's assemblies BY REFERENCE ONLY. Private=false means nothing from the
    game or BepInEx is copied to bin/. The only output meant for players is GloomSpeed.dll.
    Override the paths with -p:GameManaged=... -p:BepInExCore=...
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GloomSpeed</AssemblyName>
    <RootNamespace>GloomSpeed</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManaged Condition="'$(GameManaged)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Gloomhaven/GH_Data/Managed</GameManaged>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)/../downloads/bepinex/extracted/BepInEx/core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH.Runtime"><HintPath>$(GameManaged)/GH.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH.Runtime.FirstPass"><HintPath>$(GameManaged)/GH.Runtime.FirstPass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ScenarioRuleLibrary"><HintPath>$(GameManaged)/ScenarioRuleLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharedLibrary"><HintPath>$(GameManaged)/SharedLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ThirdParty"><HintPath>$(GameManaged)/ThirdParty.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="bolt"><HintPath>$(GameManaged)/bolt.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="bolt.user"><HintPath>$(GameManaged)/bolt.user.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="udpkit.common"><HintPath>$(GameManaged)/udpkit.common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.Epic.OnlineServices"><HintPath>$(GameManaged)/com.Epic.OnlineServices.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utilities"><HintPath>$(GameManaged)/Utilities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameManaged)/netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
